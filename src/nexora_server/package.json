{
  "name": "digital-twin-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/db-status.mjs --quiet",
    "prestart": "node scripts/db-status.mjs --quiet",
    "db:setup": "node scripts/db-setup.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:local:stop": "node scripts/db-local-stop.mjs",
    "start": "node server.js",
    "dev": "VOXCPM_BASE_URL=http://localhost:8010 nodemon server.js --ext js,mjs --ignore ../profbrain/ --ignore uploads/ --ignore ../nexora_ai/lecture_cache/ --ignore ../nexora_ai/segments/ --ignore .env",
    "test": "node --test db/migrate.test.mjs auth/passwordless.test.mjs auth/delivery.test.mjs protocol/ncipRoom.test.mjs protocol/roomRegistry.test.mjs agent/lecturePlan.test.mjs agent/professorAgent.test.mjs agent/professorMemory.test.mjs agent/userLearningMemory.test.mjs persistence/userMemoryDb.test.mjs courses/pipeline.test.mjs courses/drafts.test.mjs courses/plan.test.mjs courses/generator2.test.mjs courses/generator3.test.mjs courses/generator4.test.mjs",
    "test:e2e": "node --test e2e/privateSocial.test.mjs e2e/agentProgression.test.mjs e2e/agentDynamic.test.mjs e2e/authz.test.mjs --test-timeout=90000",
    "test:pg": "node --test auth/passwordless.pg.test.mjs"
  },
  "dependencies": {
    "@langchain/openai": "^0.0.12",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "elevenlabs-node": "^2.0.3",
    "express": "^4.18.2",
    "langchain": "^0.1.4",
    "openai": "^4.11.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pg-embedded": "^0.2.3",
    "pg-mem": "^3.0.5"
  }
}
